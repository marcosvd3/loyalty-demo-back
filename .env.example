# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/loyalty
MONGODB_DB_NAME=loyalty

# Redis (cache)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=loyalty
CACHE_TTL_MS=60000

# RabbitMQ (colas)
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=loyalty.events
RABBITMQ_QUEUE_PASS_UPDATES=pass.updates
RABBITMQ_QUEUE_NOTIFICATIONS=notifications.send

# Auth
JWT_SECRET=cambiar-en-produccion
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Front publico (lo que encodea el QR de la tienda)
APP_PUBLIC_URL=http://localhost:4200
# Tiene que coincidir con la ruta del router del front (`e/:tenantQrToken`).
APP_ENROLL_PATH=/e
